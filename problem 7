#include <stdio.h>

int main() {

    int n, i, j, pos;
    int at[20], bt[20], ct[20], tat[20], wt[20];
    int completed[20] = {0};

    int time = 0, min_bt;
    float avg_tat = 0, avg_wt = 0;

    printf("Enter number of processes: \n");
    scanf("%d", &n);

    for(i = 0; i < n; i++) {
        printf("Enter Arrival Time and Burst Time for P%d: \n", i+1);
        scanf("%d %d", &at[i], &bt[i]);
    }

    int count = 0;

    while(count < n) {

        min_bt = 999;
        pos = -1;

        for(i = 0; i < n; i++) {

            if(at[i] <= time && completed[i] == 0) {

                if(bt[i] < min_bt) {
                    min_bt = bt[i];
                    pos = i;
                }
            }
        }

        if(pos == -1) {
            time++;
        }
        else {

            ct[pos] = time + bt[pos];
            tat[pos] = ct[pos] - at[pos];
            wt[pos] = tat[pos] - bt[pos];

            avg_tat += tat[pos];
            avg_wt += wt[pos];

            completed[pos] = 1;
            time = ct[pos];

            count++;
        }
    }

    avg_tat /= n;
    avg_wt /= n;

    printf("\nAverage Turnaround Time = %.2f\n", avg_tat);
    printf("Average Waiting Time = %.2f\n", avg_wt);

    return 0;
}
