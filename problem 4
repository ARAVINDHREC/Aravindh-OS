#include <stdio.h>

int main() {

    int m, n, i, j;
    printf("Enter number of memory blocks:\n");
    scanf("%d", &m);

    int block[m], original[m];

    printf("Enter size of each block:\n");

    for(i = 0; i < m; i++) {

        scanf("%d", &block[i]);

        original[i] = block[i];
    }

    printf("Enter number of processes:\n");

    scanf("%d", &n);

    int process[n];

    printf("Enter size of each process:\n");

    for(i = 0; i < n; i++)
        scanf("%d", &process[i]);

    for(i = 0; i < n; i++) {

        int allocated = 0;
        for(j = 0; j < m; j++) {

            if(block[j] >= process[i]) {

                printf("Process %d of size %d is allocated to Block %d of size %d with Fragment %d\n",

                       i+1, process[i], j+1, original[j], block[j] - process[i]);

                block[j] -= process[i];

                allocated = 1;

                break;
            }

        }

        if(!allocated) {

            printf("Process %d of size %d is not allocated\n", i+1, process[i]);
        }

    }

    return 0;
}
